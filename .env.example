# Server Configuration
PORT=7001
NODE_ENV=development
APP_VERSION=1.0.0
API_VERSION=v1
BASE_PATH=/api
CORS_ORIGIN=*
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:7001

# Firebase Configuration
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# AI Configuration (General)
AI_PROVIDER=gemini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TOP_P=0.95
AI_TOP_K=40
AI_ENABLE_TOOLS=false

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.0-flash-exp
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_IMAGE_FLASH_MODEL=gemini-2.5-flash-image
GEMINI_DEFAULT_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_GPT4_MODEL=gpt-4-turbo-preview
OPENAI_GPT35_MODEL=gpt-3.5-turbo
OPENAI_DEFAULT_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048
OPENAI_TOP_P=0.95

# Anthropic Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_OPUS_MODEL=claude-3-opus-20240229
ANTHROPIC_SONNET_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_HAIKU_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TOP_P=0.95
ANTHROPIC_TOP_K=10

# Google Search Tool Configuration
GOOGLE_SEARCH_ENABLED=false
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Integration Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Documentation
DOCS_PASSWORD=

# Development
DEV_API_KEY=
